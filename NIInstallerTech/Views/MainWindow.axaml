<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NIInstallerTech.ViewModels"
        xmlns:local="using:NIInstallerTech"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="NIInstallerTech.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1240" Height="790" MinWidth="1050" MinHeight="680"
        Background="#F8F8F5"
        Title="NI Setup">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#005F4B" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#004B3C" />
        </Style>
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#005F4B" />
        </Style>
        <Style Selector="Button.version">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#43506A" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.version:pointerover">
            <Setter Property="Background" Value="#EDF6F3" />
            <Setter Property="Foreground" Value="#005F4B" />
        </Style>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#43506A" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.tab:pointerover">
            <Setter Property="Background" Value="#EDF6F3" />
            <Setter Property="Foreground" Value="#005F4B" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DEEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#5C615D" />
        </Style>
        <Style Selector="TextBlock.display">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="278,*" RowDefinitions="72,42,*">
        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#E4E7EF" BorderThickness="0,0,0,1">
            <Grid Margin="32,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="34" Height="32" Background="#00B894" CornerRadius="2">
                        <TextBlock Text="ni" Foreground="#004B3C" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="NI Setup" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="#DCF5EF" CornerRadius="12" Padding="9,4" Margin="6,0,0,0">
                        <TextBlock Text="Concept" Foreground="#005F4B" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#00B894" VerticalAlignment="Center" />
                    <TextBlock Text="NI software portfolio • July 2026" Classes="muted" FontSize="13" />
                    <Panel>
                        <Button Classes="version" Click="OnVersionClick" ToolTip.Tip="Check for NI Setup updates">
                            <TextBlock Text="{x:Static local:AppVersion.Display}" />
                        </Button>
                        <Ellipse x:Name="UpdateBadge" Width="8" Height="8" Fill="#F59E0B" IsVisible="False"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" />
                    </Panel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" BorderBrush="#E4E7EF" BorderThickness="0,0,0,1">
            <StackPanel Margin="32,0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Button Classes="tab" Command="{Binding ShowSetupWorkspaceCommand}" Content="Setup" />
                <Button Classes="tab" Command="{Binding ShowCatalogIntakeWorkspaceCommand}" Content="Catalog intake" />
                <TextBlock Text="Build candidate contracts from legacy installer evidence" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#004B3C" Padding="28,35" IsVisible="{Binding IsSetupWorkspace}">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="7">
                    <TextBlock Text="YOUR SETUP" Foreground="#9AE3D3" FontSize="11" FontWeight="Bold" LetterSpacing="1.2" />
                    <TextBlock Text="{Binding StepLabel}" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,38,0,0" Spacing="25">
                    <StackPanel Spacing="6">
                        <TextBlock Text="1" Foreground="#9AE3D3" FontWeight="Bold" />
                        <TextBlock Text="Goals" Foreground="White" />
                        <TextBlock Text="Choose what you need" Foreground="#D2E9E4" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="2" Foreground="#9AE3D3" FontWeight="Bold" />
                        <TextBlock Text="Plan" Foreground="White" />
                        <TextBlock Text="Review components and impact" Foreground="#D2E9E4" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="3" Foreground="#9AE3D3" FontWeight="Bold" />
                        <TextBlock Text="Review" Foreground="White" />
                        <TextBlock Text="Confirm exactly what will change" Foreground="#D2E9E4" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="4" Foreground="#9AE3D3" FontWeight="Bold" />
                        <TextBlock Text="Install" Foreground="White" />
                        <TextBlock Text="Follow each step to completion" Foreground="#D2E9E4" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2" Background="#006B56" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Clear, predictable setup" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Only decisions that affect your setup are shown." Foreground="#D2E9E4" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <Grid Margin="58,42" MaxWidth="810" IsVisible="{Binding IsSetupWorkspace}">
                <StackPanel IsVisible="{Binding IsGoalsStep}" Spacing="25">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Set up your NI software" Classes="display" />
                        <TextBlock Text="Start with the recommended foundation. Add the applications and hardware support that fit your work when you need them." Classes="muted" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Command="{Binding ChooseApiOnlyCommand}" HorizontalContentAlignment="Stretch" Background="#F2FAF7" BorderBrush="#005F4B" BorderThickness="2" CornerRadius="10" Padding="22">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="18">
                            <Border Width="42" Height="42" Background="#DCF5EF" CornerRadius="21">
                                <TextBlock Text="⌘" Foreground="#005F4B" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Recommended setup" FontSize="17" FontWeight="SemiBold" />
                                    <Border Background="#005F4B" CornerRadius="9" Padding="7,2">
                                        <TextBlock Text="BEST PLACE TO START" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="LabVIEW, NI Measurement &amp; Automation Explorer, and NI-DAQmx—the foundation for most NI measurement and automation work." Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" FontSize="30" Foreground="#005F4B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Text="You can add TestStand, FlexLogger, InstrumentStudio, DIAdem, and more on the next screen." Foreground="#005F4B" FontSize="12" TextWrapping="Wrap" />
                        </Grid>
                    </Button>

                    <TextBlock Text="OTHER WAYS TO START" Foreground="#5C615D" FontSize="11" FontWeight="Bold" LetterSpacing="1" Margin="0,8,0,-12" />
                    <Button Command="{Binding ChooseDeviceSupportCommand}" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#D9DEEA" BorderThickness="1" CornerRadius="10" Padding="22">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Border Width="42" Height="42" Background="#EAF8F1" CornerRadius="21">
                                <TextBlock Text="▣" Foreground="#197449" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Add specialized hardware or protocol support" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Start with the core setup, then select support for PXI instruments, RF, waveform generation, scopes, or industrial communications." Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" FontSize="30" Foreground="#005F4B" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Command="{Binding ChooseTestSystemCommand}" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#D9DEEA" BorderThickness="1" CornerRadius="10" Padding="22">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Border Width="42" Height="42" Background="#FFF0D4" CornerRadius="21">
                                <TextBlock Text="▤" Foreground="#8A4D00" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Set up an automated test workstation" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Start with the core setup and TestStand, then add PXI, DAQ, instrument, data, and operations software." Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" FontSize="30" Foreground="#005F4B" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Classes="card" Background="#EDF6F3" BorderThickness="0" Padding="17">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="i" FontWeight="Bold" Foreground="#005F4B" />
                            <TextBlock Text="Setup starts as a small NI-hosted downloader. On the next screen, you can instead create one portable offline installer from the same selected plan." Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsPlanStep}" Spacing="22">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Your recommended setup" Classes="display" />
                        <TextBlock Text="{Binding PlanIntroduction}" Classes="muted" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Classes="card" BorderBrush="#B8CCFA" Background="#FBFCFF">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <StackPanel Spacing="6">
                                <TextBlock Text="RECOMMENDED PLAN" Foreground="#005F4B" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
                                <TextBlock Text="{Binding PlanName}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PlanSummary}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SelectedDownloadSize}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SelectedInstallSize}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
                            </StackPanel>
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0" Background="#EDF6F3" CornerRadius="6" Padding="12,8">
                                <TextBlock Text="{Binding ImpactMessage}" Foreground="#32435F" FontSize="13" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Classes="card" Background="#FBFCFF">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Choose one LabVIEW release" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="This plan selects one platform release. Release-specific adapters follow that choice; compatible user-mode components may coexist only when the catalog allows it." Classes="muted" FontSize="13" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Command="{Binding SelectLabVIEWQ1Command}" HorizontalContentAlignment="Stretch" Background="#FFFFFF" BorderBrush="#D9DEEA" BorderThickness="1" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="LabVIEW 2026 Q1 x64" FontWeight="SemiBold" />
                                            <TextBlock Text="Observed earlier release" Classes="muted" FontSize="12" />
                                        </StackPanel>
                                        <Border Grid.Column="1" IsVisible="{Binding IsLabVIEWQ1Selected}" Background="#005F4B" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                            <TextBlock Text="SELECTED" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding SelectLabVIEWQ3Command}" HorizontalContentAlignment="Stretch" Background="#F2FAF7" BorderBrush="#005F4B" BorderThickness="1" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="LabVIEW 2026 Q3 x64" FontWeight="SemiBold" />
                                            <TextBlock Text="Observed later release • default" Classes="muted" FontSize="12" />
                                        </StackPanel>
                                        <Border Grid.Column="1" IsVisible="{Binding IsLabVIEWQ3Selected}" Background="#005F4B" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                            <TextBlock Text="SELECTED" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>
                            <Border Background="#FFF7E5" CornerRadius="6" Padding="10,7">
                                <TextBlock Text="{Binding CoexistenceSummary}" Foreground="#5B4819" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Component planes in this plan" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="These boundaries reflect the reference-system inspection: application, configuration, API/runtime, language adapter, hardware family, and firmware are separate decisions." Classes="muted" FontSize="13" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Components}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SetupComponent">
                                    <Border Classes="card" Padding="16" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <Border IsVisible="{Binding IsRequired}" Background="#DCF5EF" CornerRadius="8" Padding="7,2">
                                                        <TextBlock Text="CORE" Foreground="#005F4B" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="#EFF2F8" CornerRadius="8" Padding="7,2">
                                                        <TextBlock Text="{Binding Plane}" Foreground="#43506A" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="#FFF0D4" CornerRadius="8" Padding="7,2">
                                                        <TextBlock Text="{Binding CoexistencePolicy}" Foreground="#8A4D00" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ChangeBoundary}" Foreground="#705D1A" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="muted" FontSize="13" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Classes="card" Background="#FBFCFF" BorderBrush="#B8CCFA">
                        <StackPanel Spacing="13">
                            <StackPanel Spacing="4">
                                <TextBlock Text="How should this plan be delivered?" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="NI-hosted delivery is the normal path. An offline installer is created from this exact selection, not from a broad product image." Classes="muted" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Command="{Binding ChooseNiHostedDeliveryCommand}" HorizontalContentAlignment="Stretch" Background="#F2FAF7" BorderBrush="#005F4B" BorderThickness="1" Padding="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="↓" Foreground="#005F4B" FontSize="23" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Small setup app downloads from NI" FontWeight="SemiBold" />
                                        <TextBlock Text="Default — retrieve only the selected components from the NI-hosted catalog." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" IsVisible="{Binding IsNiHostedDelivery}" Background="#005F4B" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                        <TextBlock Text="SELECTED" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Command="{Binding ChooseOfflineBundleCommand}" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#D9DEEA" BorderThickness="1" Padding="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="▣" Foreground="#005F4B" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Create a portable offline installer" FontWeight="SemiBold" />
                                        <TextBlock Text="Retrieve all selected source components now, verify them, and create one transferable installer for disconnected systems." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" IsVisible="{Binding IsOfflineBundleDelivery}" Background="#005F4B" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                        <TextBlock Text="SELECTED" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Border Background="#FFF7E5" CornerRadius="6" Padding="11,8">
                                <TextBlock Text="Offline bundles include selected component bytes and manifests only. They do not include activation, entitlement, customer configuration, or copied driver-store state." Foreground="#5B4819" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Background="#F2FAF7" BorderBrush="#9CDACB">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Verify the download source" Foreground="#005F4B" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Setup verifies the selected package before it downloads anything. The default source is already configured for this internal validation package." Classes="muted" FontSize="13" TextWrapping="Wrap" />
                            <Button Classes="primary" Command="{Binding ConnectRepositoryCommand}" HorizontalAlignment="Left" Content="Connect and verify source" />
                            <TextBlock Text="{Binding RepositoryStatus}" Foreground="{Binding RepositoryStatusColor}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RepositoryDetails}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Expander Header="Organization-approved repository (advanced)" FontWeight="SemiBold">
                        <Border Classes="card" Margin="0,10,0,0" Padding="16">
                            <StackPanel Spacing="11">
                                <TextBlock Text="Prototype source repository" FontWeight="SemiBold" />
                                <TextBlock Text="A local web source is the preferred prototype path. It serves the approved repository over HTTP or HTTPS, avoiding SMB guest-sign-in policy. SMB remains available for internal testing." Classes="muted" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Button Command="{Binding ChooseWebRepositoryTransportCommand}" HorizontalContentAlignment="Stretch" Background="#F2FAF7" BorderBrush="#005F4B" BorderThickness="1" Padding="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Web source" FontWeight="SemiBold" />
                                                <TextBlock Text="HTTP or HTTPS endpoint" Classes="muted" FontSize="12" />
                                            </StackPanel>
                                            <Border Grid.Column="1" IsVisible="{Binding IsWebRepositoryTransport}" Background="#005F4B" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                                <TextBlock Text="SELECTED" Foreground="White" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding ChooseSmbRepositoryTransportCommand}" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#D9DEEA" BorderThickness="1" Padding="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="SMB share" FontWeight="SemiBold" />
                                                <TextBlock Text="Windows network share" Classes="muted" FontSize="12" />
                                            </StackPanel>
                                            <Border Grid.Column="1" IsVisible="{Binding IsSmbRepositoryTransport}" Background="#005F4B" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                                <TextBlock Text="SELECTED" Foreground="White" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Grid>
                                <StackPanel IsVisible="{Binding IsWebRepositoryTransport}" Spacing="7">
                                    <TextBlock Text="Local web server URL" Classes="muted" FontSize="12" />
                                    <TextBox Text="{Binding RepositoryUrl}" PlaceholderText="http://192.168.68.125:8081/files" />
                                    <TextBlock Text="Enter the server root that contains NISetupPrototypeRepository, or the repository root itself. The port is yours to choose." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid IsVisible="{Binding IsSmbRepositoryTransport}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="9">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Repository path" Classes="muted" FontSize="12" />
                                        <TextBox Text="{Binding RepositoryPath}" PlaceholderText="\\192.168.68.125\Files\NISetupPrototypeRepository" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="SMB user name (optional)" Classes="muted" FontSize="12" />
                                        <TextBox Text="{Binding RepositoryUserName}" PlaceholderText="Use current Windows sign-in" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Text="SMB password (optional)" Classes="muted" FontSize="12" />
                                        <TextBox Text="{Binding RepositoryPassword}" PasswordChar="●" PlaceholderText="Used once; never saved" />
                                    </StackPanel>
                                </Grid>
                                <Button Classes="primary" Command="{Binding ConnectRepositoryCommand}" HorizontalAlignment="Left" Content="Connect and verify source" />
                                <Border Background="#EDF6F3" CornerRadius="6" Padding="11,8">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding RepositoryStatus}" Foreground="{Binding RepositoryStatusColor}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RepositoryDetails}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                        <Button Classes="subtle" Command="{Binding BackCommand}" Content="Back" />
                        <Button Grid.Column="2" Classes="primary" Command="{Binding ContinueCommand}" Content="Review setup" />
                    </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsReviewStep}" Spacing="23">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Review before installation" Classes="display" />
                        <TextBlock Text="Nothing will change until you select Install. The source repository must be connected and approved before a deployment executor can run." Classes="muted" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Classes="card">
                        <StackPanel Spacing="17">
                            <TextBlock Text="{Binding PlanName}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedLabVIEWReleaseLabel}" Foreground="#005F4B" FontWeight="SemiBold" />
                            <Border Background="#EDF6F3" CornerRadius="7" Padding="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding DeliveryTitle}" FontWeight="SemiBold" Foreground="#005F4B" />
                                    <TextBlock Text="{Binding DeliveryDescription}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DeliveryDetail}" Foreground="#005F4B" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="35" RowSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Download" Classes="muted" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedDownloadSize}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Disk space after install" Classes="muted" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedInstallSize}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="4">
                                    <TextBlock Text="Administrative access" Classes="muted" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedAdminRequirement}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Restart" Classes="muted" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedRestartRequirement}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFF7E5" BorderBrush="#F0D89A" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <TextBlock Text="!" Foreground="#8B6300" FontWeight="Bold" />
                            <TextBlock Text="{Binding ReviewNotice}" Foreground="#5B4819" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#EDF6F3" BorderBrush="#B8CCFA" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding RepositoryStatus}" Foreground="{Binding RepositoryStatusColor}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RepositoryDetails}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding HasInstallationFailure}" Background="#FFF1F0" BorderBrush="#E6A5A0" BorderThickness="1" CornerRadius="8" Padding="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Width="30" Height="30" Background="#F8D5D2" CornerRadius="15">
                                <TextBlock Text="!" Foreground="#A52A2A" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Text="{Binding InstallationFailureTitle}" Foreground="#8F2424" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding InstallationFailureDetail}" Foreground="#5B3131" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="Next step" Foreground="#8F2424" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding InstallationRecoveryGuidance}" Foreground="#5B3131" FontSize="13" TextWrapping="Wrap" />
                                <Button Classes="primary" Command="{Binding RetryInstallationCommand}" Content="Try again" HorizontalAlignment="Left" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#F2FAF7" BorderBrush="#9CDACB" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Installation preparation" Foreground="#005F4B" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DeploymentStatus}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OperationLogPath}" Foreground="#43506A" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InstalledComponentCount, StringFormat={}{0} managed prototype component(s) currently installed}" Foreground="#43506A" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding SelectedComponentCount, StringFormat={}{0} selected components}" FontWeight="SemiBold" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding SelectedComponentNames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Classes="muted" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,7,0,0" ColumnSpacing="8">
                        <Button Classes="subtle" Command="{Binding BackCommand}" Content="Back" />
                        <Button Grid.Column="2" Classes="subtle" Command="{Binding RemovePrototypeComponentsCommand}" Content="Uninstall managed prototype components" IsVisible="{Binding HasInstalledPrototypeComponents}" />
                        <Button Grid.Column="3" Classes="primary" Command="{Binding StartInstallCommand}" Content="{Binding PrimaryActionLabel}" IsEnabled="{Binding IsInstallationExecutorAvailable}" />
                    </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsInstallingStep}" Spacing="21" VerticalAlignment="Center" Margin="0,52,0,0">
                    <StackPanel Spacing="7">
                        <TextBlock Text="{Binding InstallationHeading}" Classes="display" />
                        <TextBlock Text="{Binding InstallationPhaseTitle}" Foreground="#005F4B" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding InstallationPhaseDetail}" Classes="muted" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Background="#F7FBF9" BorderBrush="#B8DDD3" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="18">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding InstallationStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding InstallationProgressLabel}" Foreground="#005F4B" FontWeight="Bold" VerticalAlignment="Top" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding InstallProgress}" Height="10" />
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                <StackPanel Spacing="6">
                                    <Border Height="4" Background="{Binding InstallationDownloadColor}" CornerRadius="2" />
                                    <TextBlock Text="1  Download" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding InstallationDownloadState}" Foreground="{Binding InstallationDownloadColor}" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Border Height="4" Background="{Binding InstallationVerifyColor}" CornerRadius="2" />
                                    <TextBlock Text="2  Verify" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding InstallationVerifyState}" Foreground="{Binding InstallationVerifyColor}" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <Border Height="4" Background="{Binding InstallationApprovalColor}" CornerRadius="2" />
                                    <TextBlock Text="{Binding InstallationThirdPhaseLabel}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding InstallationApprovalState}" Foreground="{Binding InstallationApprovalColor}" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6">
                                    <Border Height="4" Background="{Binding InstallationApplyColor}" CornerRadius="2" />
                                    <TextBlock Text="{Binding InstallationFourthPhaseLabel}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding InstallationApplyState}" Foreground="{Binding InstallationApplyColor}" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="18">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Installation record" FontWeight="SemiBold" />
                            <TextBlock Text="Setup verifies selected artifacts before applying them. The operation log records each decision and any recovery action, so you have a clear record of this installation." Classes="muted" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OperationLogPath}" Foreground="#43506A" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsCompleteStep}" Spacing="23" VerticalAlignment="Center" Margin="0,65,0,0">
                    <Border Width="58" Height="58" Background="#EAF8F1" CornerRadius="29" HorizontalAlignment="Left">
                        <TextBlock Text="✓" Foreground="#197449" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding CompletionHeading}" Classes="display" />
                        <TextBlock Text="{Binding CompletionMessage}" Classes="muted" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Clean-machine deployment is recorded" FontWeight="SemiBold" />
                            <TextBlock Text="Only files verified from the selected package are recorded in the machine-level ownership ledger. Existing NI activation and licensing tooling remains unchanged." Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OperationLogPath}" Foreground="#43506A" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Button Classes="subtle" Command="{Binding RemovePrototypeComponentsCommand}" Content="Uninstall managed prototype components" IsVisible="{Binding HasInstalledPrototypeComponents}" HorizontalAlignment="Left" />
                    <Button Classes="primary" Command="{Binding StartOverCommand}" Content="Explore another setup" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="58,42" MaxWidth="920" Spacing="24" IsVisible="{Binding IsCatalogIntakeWorkspace}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Catalog intake" Classes="display" />
                    <TextBlock Text="Index legacy installation sources, choose a discovered package, and create a reviewable candidate contract from its captured metadata. Indexing never executes installers or approves deployment." Classes="muted" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>

                <Border Classes="card" BorderBrush="#9CDACB" Background="#F7FBF9">
                    <StackPanel Spacing="13">
                        <TextBlock Text="Local NI Package Manager" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Setup detects NIPM on this computer and reads its local package cache automatically. It does not run NIPM, change the cache, or approve a package for deployment." Classes="muted" FontSize="13" TextWrapping="Wrap" />
                        <Border Background="White" BorderBrush="#D9DEEA" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding LegacyPackageManagerDetails}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LegacyPackageIndexStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="subtle" Command="{Binding RefreshLocalNativePackageManagerCommand}" Content="Refresh package list" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Discovered NI product" Classes="muted" FontSize="12" />
                            <ComboBox ItemsSource="{Binding LegacyProductOptions}" SelectedItem="{Binding SelectedLegacyProduct}" MinHeight="38" PlaceholderText="Index a package cache to populate this list">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Margin="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding VersionLabel}" Classes="muted" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="NIPM" Foreground="#005F4B" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Border IsVisible="{Binding HasSelectedLegacyProduct}" Background="White" BorderBrush="#D9DEEA" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SelectedLegacyProduct.ProductName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedLegacyProduct.VersionLabel}" Foreground="#005F4B" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedLegacyProduct.ProductKey}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border IsVisible="{Binding HasProductPreview}" Background="White" BorderBrush="#9CDACB" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="13">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Repackaging preview" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedProductPreview.Summary}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="150,*,Auto">
                                        <TextBlock Text="Today: NIPM packages" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding SelectedProductPreview.ArtifactBarMaximum}" Value="{Binding SelectedProductPreview.ArtifactBarMaximum}" Height="8" Foreground="#B9C4D6" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding SelectedProductPreview.LegacyPackageCount, StringFormat='{}{0} packages'}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="150,*,Auto">
                                        <TextBlock Text="After repackaging" FontSize="12" Foreground="#005F4B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding SelectedProductPreview.ArtifactBarMaximum}" Value="{Binding SelectedProductPreview.ProjectedInstallableCount}" Height="8" Foreground="#00B894" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="1 component" FontSize="12" Foreground="#005F4B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="5" IsVisible="{Binding SelectedProductPreview.HasMeasuredSize}">
                                    <Grid ColumnDefinitions="150,*,Auto">
                                        <TextBlock Text="Today: source size" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding SelectedProductPreview.SizeBarMaximum}" Value="{Binding SelectedProductPreview.SizeBarMaximum}" Height="8" Foreground="#B9C4D6" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding SelectedProductPreview.LegacySizeText}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="150,*,Auto">
                                        <TextBlock Text="Estimated new size" FontSize="12" Foreground="#005F4B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding SelectedProductPreview.SizeBarMaximum}" Value="{Binding SelectedProductPreview.ProjectedBarValue}" Height="8" Foreground="#00B894" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding SelectedProductPreview.ProjectedSizeText}" FontSize="12" Foreground="#005F4B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedProductPreview.ReductionText}" FontSize="12" Foreground="#005F4B" HorizontalAlignment="Right" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding SelectedProductPreview.TopHighlights}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                                <TextBlock Text="&#8226;" Foreground="#00B894" Margin="0,0,7,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Header="See the full findings and how this was estimated">
                                    <StackPanel Margin="0,9,0,0" Spacing="11">
                                        <TextBlock Text="{Binding SelectedProductPreview.EstimationBasis}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Unique dependencies" Classes="muted" FontSize="11" />
                                                <TextBlock Text="{Binding SelectedProductPreview.UniqueDependencyCount}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Shared prerequisites" Classes="muted" FontSize="11" />
                                                <TextBlock Text="{Binding SelectedProductPreview.SharedPrerequisiteCount}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Source artifacts" Classes="muted" FontSize="11" />
                                        <ItemsControl ItemsSource="{Binding SelectedProductPreview.Breakdown}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto,90" Margin="0,1">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" Margin="10,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="What changes" Classes="muted" FontSize="11" />
                                        <ItemsControl ItemsSource="{Binding SelectedProductPreview.Highlights}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                                        <TextBlock Text="&#8226;" Foreground="#00B894" Margin="0,0,7,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="primary" Command="{Binding CreateCandidateFromSelectedPackageCommand}" IsEnabled="{Binding HasSelectedLegacyProduct}" Content="Approve repackaging &amp; create contract" />
                            <TextBlock Text="{Binding CandidateIntakeStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="500" />
                        </StackPanel>
                        <Expander Header="Use a nonstandard or mounted NIPM cache" FontWeight="SemiBold">
                            <StackPanel Margin="0,10,0,0" Spacing="7">
                                <TextBlock Text="Use this only when NIPM is installed outside the standard Windows location or the package source is mounted from another approved machine." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBox Text="{Binding LegacyPackageSourcePath}" PlaceholderText="C:\ProgramData\National Instruments\NI Package Manager" />
                                    <Button Grid.Column="1" Classes="primary" Command="{Binding IndexLegacyPackageSourceCommand}" Content="Index this cache" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="9">
                        <TextBlock Text="Component source output" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Cataloged product source files are written here. This is pre-populated with the mounted SMB prototype repository; change it to any writable local or mounted path." Classes="muted" FontSize="13" TextWrapping="Wrap" />
                        <TextBox Text="{Binding CandidateOutputRoot}" MinHeight="38" PlaceholderText="/Volumes/Files/NISetupPrototypeRepository/metadata/candidate-contracts" />
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="280,*" ColumnSpacing="22">
                    <StackPanel Spacing="9">
                        <TextBlock Text="Candidate contracts" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Written to the configured source output for iterative review." Classes="muted" FontSize="12" />
                        <ListBox ItemsSource="{Binding CandidateContracts}" SelectedItem="{Binding SelectedCandidate}" MinHeight="230">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Id}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ReviewStatus}" Foreground="#005F4B" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding CandidateCatalogPath}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="16" IsVisible="{Binding HasSelectedCandidate}">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding SelectedCandidate.DisplayName}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedCandidate.Id}" Foreground="#005F4B" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Observed version" Classes="muted" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedCandidate.ObservedVersion}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Legacy packages" Classes="muted" FontSize="12" />
                                        <ItemsControl ItemsSource="{Binding SelectedCandidate.LegacyPackageNames}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Dependencies observed in native package control metadata" Classes="muted" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding SelectedCandidate.Dependencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Foreground="#43506A" FontSize="12" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Background="#FBFCFF">
                            <StackPanel Spacing="9">
                                <TextBlock Text="Evidence captured" FontSize="16" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SelectedCandidate.Evidence}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E4E7EF" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Observation}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Sha256}" Foreground="#43506A" FontFamily="Menlo" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF7E5" BorderBrush="#F0D89A" BorderThickness="1" CornerRadius="8" Padding="15">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Evidence gaps to resolve" Foreground="#5B4819" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SelectedCandidate.Warnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Foreground="#5B4819" FontSize="12" TextWrapping="Wrap" Margin="0,2" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" BorderBrush="#B8CCFA">
                            <StackPanel Spacing="12">
                                <TextBlock Text="R&amp;D review" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="These fields are authored decisions. They survive the next evidence refresh and do not make the candidate installable." Classes="muted" FontSize="13" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Review status" Classes="muted" FontSize="12" />
                                        <TextBox Text="{Binding CandidateReviewStatus}" PlaceholderText="awaiting-rd-review" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="Declared install mode" Classes="muted" FontSize="12" />
                                        <TextBox Text="{Binding CandidateDeclaredInstallMode}" PlaceholderText="undecided" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Review notes, decisions, and open questions" Classes="muted" FontSize="12" />
                                    <TextBox Text="{Binding CandidateReviewNotes}" AcceptsReturn="True" MinHeight="84" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Reviewed by" Classes="muted" FontSize="12" />
                                    <TextBox Text="{Binding CandidateReviewedBy}" PlaceholderText="Product and installer R&amp;D owners" />
                                </StackPanel>
                                <Button Classes="primary" Command="{Binding SaveCandidateReviewCommand}" Content="Save R&amp;D review" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
